# Stripe Payment Link (opens in new tab from create flow)
STRIPE_PAYMENT_LINK=https://buy.stripe.com/your_link_here

# Set to 1 to skip payment gate in preview / local demo
LIVEPROOF_DEV_BYPASS=1

# Optional: Vercel Blob read/write token for durable video storage on Vercel
# Without this on Vercel, videos go to /tmp (ephemeral) + in-memory Map
BLOB_READ_WRITE_TOKEN=
