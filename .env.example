# Stripe Payment Link (same-window from create flow; redirect returns with ?paid=1)
STRIPE_PAYMENT_LINK=https://buy.stripe.com/dRmdR89i93oGcKQ8f38og0K

# Set to 1 to skip payment gate in preview / local demo (do NOT use in production)
LIVEPROOF_DEV_BYPASS=1

# Optional: Vercel Blob read/write token for durable video storage on Vercel
# Without this on Vercel, videos go to /tmp (ephemeral) + in-memory Map
BLOB_READ_WRITE_TOKEN=
