# Stripe — required in production (never commit real values)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Existing Payment Link (keep this URL). After payment, Stripe must redirect with session_id.
STRIPE_PAYMENT_LINK=https://buy.stripe.com/dRmdR89i93oGcKQ8f38og0K

# Set to 1 to skip payment gate in local / preview only (ignored when VERCEL_ENV=production)
LIVEPROOF_DEV_BYPASS=1

# Optional: admin purge API (Authorization: Bearer ...)
LIVEPROOF_ADMIN_SECRET=

# Vercel Blob — durable video + meta. Vercel injects this when a Blob store is connected.
# Without it on Vercel, files go to /tmp + memory (ephemeral).
BLOB_READ_WRITE_TOKEN=

# Optional: force Blob access mode. Default tries private, then public if the store is public-only.
# BLOB_ACCESS=private
# BLOB_STORE_ID=
